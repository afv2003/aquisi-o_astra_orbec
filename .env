# Identificação do grupo (lida automaticamente pelo docker compose)
GRUPO=g05
# Valor provisório; o oficial é fixado no repositório comum
ROS_DOMAIN_ID=42

# Motor ONNX instalado na imagem (docker compose build): onnxruntime = CPU (qualquer PC).
# GPU NVIDIA (README, 3.3): onnxruntime-gpu[cuda,cudnn] (drivers com CUDA 13+) ou
# onnxruntime-gpu[cuda,cudnn]<1.27 (CUDA 12.x); depois de mudar, construir de novo a imagem.
ONNX_PKG=onnxruntime

# Câmaras ao vivo (o scripts/online.sh define-as a partir dos argumentos: 5 8 -> /dev/video2, /dev/video4)
CAMARAS=5 8
DEV_CAMARA5=/dev/video2
DEV_CAMARA8=/dev/video4

# Pasta dos dados, montada em /data: gravações do online (data/<sessão>/), resultados do ros2 bag e
# bags a reproduzir. Na aquisição, pode ser o disco externo (ex.: DADOS=/media/<utilizador>/SSD/g05)
DADOS=./data

# Bag a reproduzir com --profile reproduzir, dentro de DADOS (o scripts/online.sh --bag aceita qualquer caminho)
BAG=

# Parte 2: tópicos de outros sensores do carro (de outros grupos) a gravar nos trechos e a usar (README, 3.15).
# Vazio = /fix /odom /tf /estrada/centro; "topico=pacote/msg/Tipo" para outro nome; "nenhum" desliga.
OUTROS_SENSORES=

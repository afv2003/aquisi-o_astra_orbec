<?xml version="1.0"?>
<package format="3">
  <name>va_manobras</name>
  <version>0.1.0</version>
  <description>Estrada como referência (Frenet), ocupação da faixa, manobra de exemplo e simulador 2D (comum a todos os grupos de VA)</description>
  <maintainer email="va@ua.pt">Docentes de VA</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>va_planeamento</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<package format="3">
  <name>va_g05</name>
  <version>0.1.0</version>
  <description>G5 (projeto 3, câmaras laterais): perceção das câmaras Astra, grelha local, avisos de mudança de faixa, saída de faixa e colisão, visualizador e reprodução de bags</description>
  <maintainer email="grupo05@ua.pt">Grupo 05</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>va_planeamento</exec_depend>
  <exec_depend>va_manobras</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

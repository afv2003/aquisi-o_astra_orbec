ARG BASE_IMAGE=ros:jazzy-ros-base
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-c"]

ARG ONNX_PKG=onnxruntime

# Instalar ROS, driver da câmara e dependências para Python e OpenCV
# (compressed-image-transport: o driver publica também a imagem em JPEG, que é a que se grava;
#  rviz2: validação das câmaras e da grelha, processar_inter.sh --rviz;
#  foxglove-bridge: ver os tópicos ao vivo no Foxglove Studio, processar_inter.sh --foxglove;
#  python3-tk: janela do resumo no fim do processamento, resumo_online.py)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-usb-cam \
    ros-jazzy-compressed-image-transport \
    ros-jazzy-rviz2 \
    ros-jazzy-foxglove-bridge \
    python3-venv \
    python3-pip \
    python3-tk \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Criar ambiente virtual e colocar no PATH
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Instalar requisitos: ignora as linhas onnxruntime* do requirements.txt (usa ONNX_PKG) e o
# tkintermapview (o mapa é só da janela de resultados do offline, gui_resultados.py)
COPY requirements.txt /tmp/
RUN grep -Ev '^[[:space:]]*(onnxruntime|tkintermapview)' /tmp/requirements.txt > /tmp/req_base.txt \
    && pip install --no-cache-dir -r /tmp/req_base.txt "${ONNX_PKG}"

# Configurar o entrypoint do ROS
RUN printf '%s\n' '#!/bin/bash' 'set -e' \
    'source /opt/ros/jazzy/setup.bash' 'exec "$@"' \
    > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

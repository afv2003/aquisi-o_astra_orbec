ARG BASE_IMAGE=ros:jazzy-ros-base
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-c"]

ARG ONNX_PKG=onnxruntime

# Instalar ROS, driver da câmara e dependências para Python e OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-usb-cam \
    python3-venv \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Criar ambiente virtual e colocar no PATH
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Instalar requisitos (ignora qualquer linha onnxruntime* do requirements.txt e usa ONNX_PKG)
COPY requirements.txt /tmp/
RUN grep -Ev '^[[:space:]]*onnxruntime' /tmp/requirements.txt > /tmp/req_base.txt \
    && pip install --no-cache-dir -r /tmp/req_base.txt "${ONNX_PKG}"

# Configurar o entrypoint do ROS
RUN printf '%s\n' '#!/bin/bash' 'set -e' \
    'source /opt/ros/jazzy/setup.bash' 'exec "$@"' \
    > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
